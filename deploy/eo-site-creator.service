[Unit]
Description=EdgeOne Site Creator Web Console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/eo-site-creator
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/python3 /opt/eo-site-creator/app.py --host 0.0.0.0 --port 8088
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
