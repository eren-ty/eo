# Copy this file to dns-providers.env and fill the credentials you need.

# Tencent DNSPod API 3.0 credentials.
# Recommended: create a CAM sub-user/key with DNSPod record write permissions.
DNSPOD_SECRET_ID=
DNSPOD_SECRET_KEY=

# Alibaba Cloud DNS credentials.
# Recommended: create a RAM user/key with AliDNS record write permissions.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# Optional: more Alibaba Cloud DNS accounts.
# Suffix can be any label, for example 02 / 03 / prod / backup.
ALIYUN_ACCESS_KEY_ID_02=
ALIYUN_ACCESS_KEY_SECRET_02=
ALIYUN_ACCESS_KEY_ID_03=
ALIYUN_ACCESS_KEY_SECRET_03=
